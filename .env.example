# Frontend API URL configuration
# In local development, the Vite proxy forwards '/api' to 'http://localhost:5000'
VITE_API_URL=/api

# Google OAuth web client ID for the sign-in button in the browser.
# Must match the OAuth 2.0 Web client in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# For production deployments where backend is on a separate domain (e.g., Render, Railway, Vercel):
# VITE_API_URL=https://api.yourdomain.com/api