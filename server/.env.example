# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgres://user:password@localhost:5432/grocart

# ---- JWT (each secret: 32+ random characters, and they must be different) ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-at-least-32-characters-secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
JWT_ISSUER=grocart-api
JWT_AUDIENCE=grocart-web

# ---- Security tuning ----
BCRYPT_ROUNDS=12
TRUST_PROXY=0
RATE_LIMIT_STORE_CLEANUP_INTERVAL_MS=60000
RATE_LIMIT_STORE_IDLE_TIMEOUT_MS=3600000
RATE_LIMIT_MESSAGE=Too many requests. Please try again later.
LOGIN_LOCK_MESSAGE=Too many failed sign-in attempts. Try again later.
COOKIE_REQUEST_HEADER_MESSAGE=A custom request header is required.
AUTH_INVALID_CREDENTIALS_MESSAGE=Invalid email or password.
REGISTRATION_NEUTRAL_MESSAGE=If this email can be registered, the request has been accepted.
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
PROFILE_JSON_BODY_LIMIT=3mb
AVATAR_MAX_BYTES=1048576
AVATAR_VALIDATION_MESSAGE=Avatar must be a png, jpeg, or webp image within the configured size limit.
PRODUCT_IMAGE_VALIDATION_MESSAGE=Product images must use HTTPS or a local public path.
PAGINATION_DEFAULT_LIMIT=25
PAGINATION_MAX_LIMIT=100
PAGINATION_MAX_OFFSET=1000000
API_RATE_LIMIT_CAPACITY=300
API_RATE_LIMIT_REFILL_PER_SECOND=5
API_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_CAPACITY=60
REFRESH_RATE_LIMIT_REFILL_PER_SECOND=1
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
ORDER_RATE_LIMIT_CAPACITY=5
ORDER_RATE_LIMIT_REFILL_PER_SECOND=0.1
ORDER_RATE_LIMIT_WINDOW_SECONDS=60
PROFILE_RATE_LIMIT_CAPACITY=10
PROFILE_RATE_LIMIT_REFILL_PER_SECOND=0.2
PROFILE_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_EMAIL_FAILURE_CAPACITY=5
LOGIN_EMAIL_FAILURE_WINDOW_MINUTES=15
LOGIN_EMAIL_LOCK_MINUTES=15
LOGIN_IP_FAILURE_CAPACITY=20
LOGIN_IP_FAILURE_WINDOW_MINUTES=15
REGISTER_RATE_LIMIT_CAPACITY=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=60
REFRESH_TOKEN_CLEANUP_INTERVAL_MINUTES=60

# ---- First admin (used ONLY by: npm run seed) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-strong-password
