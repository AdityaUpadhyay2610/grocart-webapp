# Required runtime values
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grocart

# JWT secrets: 32+ random characters, and both must be different
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-at-least-32-characters-secret
JWT_ISSUER=grocart-api
JWT_AUDIENCE=grocart-web

# Google OAuth web client ID.
# Must match the same value in the frontend root .env as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Optional config overrides. The app already has safe defaults in server/src/config/config.js.
TRUST_PROXY=0

# Optional admin seed values for: npm run seed
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-me-with-a-strong-password

# Optional payment keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=